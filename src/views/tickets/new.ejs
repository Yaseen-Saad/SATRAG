<% title = 'New Ticket'; %>
<div class="dashboard">
  <div class="dash-header">
    <div>
      <h1>New Ticket</h1>
      <p class="dash-subtitle">Describe your issue or question</p>
    </div>
    <div class="dash-header-actions">
      <a href="/tickets" class="btn btn-outline btn-sm">All Tickets</a>
    </div>
  </div>
  <% if (typeof error !== 'undefined' && error) { %>
  <div class="flash flash-error"><%= error %></div>
  <% } %>
  <div class="dash-card">
    <div class="dash-card-body">
      <form method="POST" action="/tickets/new">
        <div class="form-group">
          <label for="subject">Subject</label>
          <input type="text" id="subject" name="subject" required maxlength="200" placeholder="e.g. AI-generated question has wrong answer">
        </div>
        <div class="form-group">
          <label for="section">Section</label>
          <select id="section" name="section">
            <option value="">General</option>
            <option value="vocab">Vocabulary</option>
            <option value="practice">Practice</option>
            <option value="flashcards">Flashcards</option>
            <option value="account">Account</option>
            <option value="billing">Billing</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">First message</label>
          <textarea id="message" name="message" rows="3" maxlength="2000" placeholder="Details help us help you faster"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Create Ticket</button>
      </form>
    </div>
  </div>
</div>