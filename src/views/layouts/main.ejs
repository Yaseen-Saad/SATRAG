<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../partials/head') %>
</head>

<body>
  <%- include('../partials/nav') %>
  <main id="main-content">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>
  <%- include('../partials/footer') %>

  <script src="/js/app.js"></script>
  <% if (typeof pageClass !== 'undefined' && pageClass){ if(pageClass.includes('practice')) { %>
  <script src="/js/bluebook.js"></script>
  <% } if (pageClass.includes('landing')) { %>
  <script src="/js/landing.js"></script>
  <% }} %>
  <div x-data="globalLoader" x-show="loading" x-cloak style="position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);">
    <div class="spinner-large"></div>
  </div>
</body>

</html>