          <line x1="170" y1="60" x2="170" y2="80" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" class="hiw-cursor"/>
          <text x="40" y="125" fill="#64748B" font-family="ui-sans-serif,system-ui,sans-serif" font-size="12">Your query enters as plain text</text>
        </svg>
      </div>
      <div class="hiw-step-text">
        <span class="hiw-step-num">1</span>
        <h3>You type a word</h3>
        <p>Your query enters as raw text — just a string of characters like <strong>"perspicacious"</strong></p>
      </div>
    </div>

    <div class="hiw-step">
      <div class="hiw-step-visual">
        <svg viewBox="0 0 320 180" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Tokenization">
          <text x="160" y="28" fill="#64748B" font-family="ui-sans-serif,system-ui,sans-serif" font-size="11" text-anchor="middle">tokenizer</text>
          <rect x="22" y="42" width="68" height="36" rx="8" fill="#0C4A6E" stroke="#38BDF8" stroke-width="1.2"/>
          <text x="56" y="65" fill="#7DD3FC" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="13" text-anchor="middle">per</text>
          <rect x="100" y="42" width="60" height="36" rx="8" fill="#064E3B" stroke="#3FCF8E" stroke-width="1.2"/>
          <text x="130" y="65" fill="#6EE7B7" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="13" text-anchor="middle">spi</text>
          <rect x="168" y="42" width="56" height="36" rx="8" fill="#3B0764" stroke="#A78BFA" stroke-width="1.2"/>
          <text x="196" y="65" fill="#C4B5FD" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="13" text-anchor="middle">ca</text>
          <rect x="232" y="42" width="68" height="36" rx="8" fill="#78350F" stroke="#FBBF24" stroke-width="1.2"/>
          <text x="266" y="65" fill="#FDE68A" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="13" text-anchor="middle">cious</text>
          <line x1="92" y1="60" x2="100" y2="60" stroke="#475569" stroke-width="1.2"/>
          <line x1="162" y1="60" x2="168" y2="60" stroke="#475569" stroke-width="1.2"/>
          <line x1="226" y1="60" x2="232" y2="60" stroke="#475569" stroke-width="1.2"/>
          <text x="160" y="112" fill="#E2E8F0" font-family="ui-sans-serif,system-ui,sans-serif" font-size="12" text-anchor="middle">↓ each token maps to a 1024-dim vector</text>
          <rect x="32" y="130" width="58" height="22" rx="4" fill="#0C4A6E" opacity="0.5"/>
          <text x="61" y="145" fill="#7DD3FC" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" text-anchor="middle">[0.12,-0.8]</text>
          <rect x="98" y="130" width="58" height="22" rx="4" fill="#064E3B" opacity="0.5"/>
          <text x="127" y="145" fill="#6EE7B7" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" text-anchor="middle">[0.44,0.3]</text>
          <rect x="164" y="130" width="58" height="22" rx="4" fill="#3B0764" opacity="0.5"/>
          <text x="193" y="145" fill="#C4B5FD" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" text-anchor="middle">[-0.2,0.9]</text>
          <rect x="230" y="130" width="58" height="22" rx="4" fill="#78350F" opacity="0.5"/>
          <text x="259" y="145" fill="#FDE68A" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="9" text-anchor="middle">[0.71,0.1]</text>
        </svg>
      </div>
      <div class="hiw-step-text">
        <span class="hiw-step-num">2</span>
        <h3>Tokens become vectors</h3>
        <p>Our embedding model converts your word into a <strong>1024-dimensional vector</strong> — a precise numerical fingerprint that captures its meaning</p>
