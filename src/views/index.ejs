          <text x="128" y="96" fill="#3B82F6" font-family="ui-monospace,SFMono-Regular,Menlo,monospace" font-size="10">y</text>
          <circle cx="185" cy="90" r="7" fill="#38BDF8" opacity="0.3"/>
          <circle cx="185" cy="90" r="4" fill="#38BDF8"/>
          <line x1="60" y1="150" x2="185" y2="90" stroke="#38BDF8" stroke-width="1.5" stroke-dasharray="5 3" opacity="0.5"/>
